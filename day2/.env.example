# Copy to .env and fill in.

# Free option (default): NVIDIA Nemotron 3 Ultra via OpenRouter.
# Get a key at https://openrouter.ai/keys
PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# BASE_URL=https://openrouter.ai/api/v1
# For NVIDIA's own API instead: BASE_URL=https://integrate.api.nvidia.com/v1, put the nvapi- key in OPENROUTER_API_KEY,
# and use the model id shown on build.nvidia.com.

# Paid option: Claude.
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-haiku-5-5

PORT=3000
# Optional: n8n / Make / Zapier webhook that sends the WhatsApp or email lead alert
LEAD_WEBHOOK_URL=
